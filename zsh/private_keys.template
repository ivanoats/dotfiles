# Private keys and secrets
# This file is for storing private API keys and secrets
# 
# Setup Instructions:
# 1. Copy this file to private_keys: cp zsh/private_keys.template zsh/private_keys
# 2. Add your private keys and secrets to the private_keys file
# 3. The private_keys file is in .gitignore and will not be committed
#
# Example entries:
# export AWS_ACCESS_KEY_ID="your-key-here"
# export AWS_SECRET_ACCESS_KEY="your-secret-here"
# use gh command for github token
export GITHUB_TOKEN="$(env -u GITHUB_TOKEN -u GH_TOKEN gh auth token 2>/dev/null)"
export HOMEBREW_GITHUB_API_TOKEN="$GITHUB_TOKEN"